# Application Settings
PROJECT_NAME="DigiCampus Attendance Dispute System"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=digiicampus
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/digiicampus

# Authentication Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@domain.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@domain.com
