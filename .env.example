# Application Settings
PROJECT_NAME="DigiCampus Attendance Dispute System"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=digiicampus
DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@localhost:3306/digiicampus

# Docker Compose DB Configuration
MYSQL_ROOT_PASSWORD=your_mysql_password_here

# Authentication Configuration
JWT_SECRET=replace_with_a_strong_random_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Configuration (optional — leave blank to disable email delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@example.com

# Celery / Redis Background Processing
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Worker Scheduling Intervals (seconds)
ESCALATION_WORKER_INTERVAL_SECONDS=60
EMAIL_OUTBOX_INTERVAL_SECONDS=30

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

